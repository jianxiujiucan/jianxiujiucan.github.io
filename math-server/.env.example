# ---- Server ----
PORT=3000

# ---- MySQL（启动时自动建库建表，无需手动 CREATE DATABASE）----
# 用 127.0.0.1 而不是 localhost：Node 22 下 localhost 可能先解析到 ::1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=math_quiz

# ---- JWT ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- bcrypt ----
BCRYPT_ROUNDS=10

# ---- CORS 白名单（逗号分隔）----
CORS_ORIGINS=https://jianxiujiucan.github.io,http://localhost:5173,http://127.0.0.1:5173

# ---- SMTP（可选；留空则验证码打印到后端控制台）----
# QQ邮箱示例：SMTP_HOST=smtp.qq.com，SMTP_PASS 填「设置→账户→SMTP服务」获取的授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 找回密码验证码 ----
RESET_CODE_TTL_MINUTES=10
RESET_CODE_RESEND_COOLDOWN_SECONDS=60
