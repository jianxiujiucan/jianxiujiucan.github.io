# ---- Server ----
PORT=3000

# ---- Postgres（Supabase）----
# Supabase 控制台 → 项目 → Connect → Transaction pooler（serverless 友好，端口 6543）：
# postgresql://postgres.<project-ref>:<数据库密码>@aws-x-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Supabase 需要 SSL；本地直连自建 Postgres 时设为 false
DB_SSL=true

# ---- JWT ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- bcrypt ----
BCRYPT_ROUNDS=10

# ---- CORS 白名单（逗号分隔）----
CORS_ORIGINS=https://jianxiujiucan.github.io,http://localhost:5173,http://127.0.0.1:5173

# ---- SMTP（找回密码发邮件；留空则验证码打印到控制台，仅本地开发用）----
# QQ邮箱示例：SMTP_HOST=smtp.qq.com，SMTP_PASS 填「设置→账户→SMTP服务」获取的授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 找回密码验证码 ----
RESET_CODE_TTL_MINUTES=10
RESET_CODE_RESEND_COOLDOWN_SECONDS=60
